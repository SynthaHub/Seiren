# Copy to .env and fill in. Never commit .env.
#
# Everything prefixed VITE_ is bundled into the client and is PUBLIC.
# Never put a secret, API key, or token here.

# Where the enquiry form POSTs. Outstanding — needs a serverless function,
# a form service, or Sazara's backend. Must validate server-side too.
VITE_ENQUIRY_ENDPOINT=

# Where the newsletter capture POSTs. Separate from enquiries on purpose.
VITE_NEWSLETTER_ENDPOINT=
